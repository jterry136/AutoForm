# ─── AutoForm environment ────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# These are validated on first import of src/lib/env.ts (ArkType). Server-side
# only. Full reference — what each one does, what breaks without it, how to
# generate it: docs/configuration.md

# ─── Required ────────────────────────────────────────────────────────────────

# Supabase Postgres connection string.
# Dashboard → Project → Connect → ORMs (Drizzle). Use the Transaction pooler URL.
# postgres-js is configured with prepare:false to work with the pooler.
DATABASE_URL=

# Better Auth session signing secret. Generate with:
#   openssl rand -base64 32
# Rotating it signs every existing session out.
BETTER_AUTH_SECRET=

# Public base URL of this instance, no trailing slash. Must match the URL users
# actually reach, or sign-in redirects and cookies land on the wrong origin.
BETTER_AUTH_URL=http://localhost:3000

# Destination-credential encryption key (AES-256-GCM, D-004): 32 bytes, base64.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored destination credentials undecryptable.
ENCRYPTION_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# Resend API key — required only by the email connector.
# https://resend.com/api-keys
# Leave blank and everything else still works, but email destinations are
# rejected at configuration time and email deliveries dead-letter.
RESEND_API_KEY=

# Delivery-health detection (DECISIONS.md D-010). Both optional — leave blank for
# the defaults. THRESHOLD is how many consecutive dead-lettered deliveries flag a
# destination as unhealthy (default 3); COOLOFF_MINUTES is the minimum gap between
# two alerts about the same destination (default 1440 = 24h).
DELIVERY_HEALTH_THRESHOLD=
DELIVERY_HEALTH_COOLOFF_MINUTES=

# How often the in-process retention purge pass runs, in milliseconds.
# Defaults to hourly (3600000); values below 60000 are clamped to one minute.
RETENTION_PURGE_INTERVAL_MS=

# From address for AutoForm's own platform mail (delivery-failure alerts), e.g.
# `AutoForm <notifications@example.com>`. Defaults to Resend's onboarding sender,
# which is only suitable for testing. Use a verified domain.
MAIL_FROM=
